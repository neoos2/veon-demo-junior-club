---
// Inline 2px-stroke icons (no icon font). Colour follows currentColor.
interface Props { name: "phone" | "ball" | "map" | "arrow-down" | "arrow-right" | "instagram" | "facebook" | "mail" | "close" | "whistle"; size?: number; class?: string; }
const { name, size = 24, class: cls } = Astro.props;
---
<svg class:list={["icon", cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === "phone" && <path d="M5 3.5h3.2l1.6 4.2-2.2 1.4a11.5 11.5 0 0 0 7.3 7.3l1.4-2.2 4.2 1.6V19a1.8 1.8 0 0 1-2 1.8A17.3 17.3 0 0 1 3.2 5.5 1.8 1.8 0 0 1 5 3.5Z" />}
  {name === "ball" && <><circle cx="12" cy="12" r="9" /><path d="m12 8 3.3 2.4-1.3 3.9h-4l-1.3-3.9L12 8Zm0 0V3.2m3.3 7.2 4.4-1.6m-5.7 5.5 2.6 3.9m-6.6-3.9-2.6 3.9m1.3-7.5L4.3 8.8" /></>}
  {name === "map" && <><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" /><circle cx="12" cy="10" r="2.4" /></>}
  {name === "arrow-down" && <path d="M12 4v15m-6-6 6 6 6-6" />}
  {name === "arrow-right" && <path d="M4 12h15m-6-6 6 6-6 6" />}
  {name === "instagram" && <><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r=".6" fill="currentColor" /></>}
  {name === "facebook" && <path d="M14.5 8.5H17V5h-2.5A3.5 3.5 0 0 0 11 8.5V11H8.5v3.5H11V21h3.5v-6.5H17l.5-3.5h-3V9a.5.5 0 0 1 .5-.5Z" />}
  {name === "mail" && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3.5 6 8.5 7 8.5-7" /></>}
  {name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
  {name === "whistle" && <><circle cx="9" cy="14" r="5" /><path d="M12.5 10.5 21 6v4h-6.6M9 14h.01" /></>}
</svg>
