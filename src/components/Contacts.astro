---
// «Вихід на поле»: the close on the yellow field. Real channels only (company.contacts, L-F003); no form (demo.md §6).
import Section from "./Section.astro";
import Icon from "./Icon.astro";
import { arenas, email, phones, socials } from "../data/club";
---
<Section id="contacts" rec="UX-R003" class="section contacts on-yellow">
  <div class="container contacts__grid">
    <div class="contacts__main">
      <h2>Вихід на поле: запишіться на перше заняття</h2>
      <a class="big-phone" href={`tel:${phones.main.tel}`} data-rec="UX-R003,B-R002,G-R001,MT-R001">
        <Icon name="phone" size={40} />
        <span>{phones.main.label}</span>
      </a>
      <p class="contacts__hint">Назвіть вік дитини і зручну арену.</p>
    </div>
    <ul class="lines">
      <li><a class="line" href={`tel:${phones.second.tel}`} data-rec="UX-R003"><Icon name="phone" /><span>{phones.second.label}</span></a></li>
      <li><a class="line" href={`mailto:${email}`}><Icon name="mail" /><span>{email}</span></a></li>
      {arenas.map((a) => (
        <li><a class="line" href={a.map} target="_blank" rel="noopener"><Icon name="map" /><span>{a.district}: {a.short}</span><span class="line__more">Маршрут</span></a></li>
      ))}
      {socials.map((s) => (
        <li><a class="line" href={s.url} target="_blank" rel="noopener" data-rec="S-R012"><Icon name={s.name === "Instagram" ? "instagram" : "facebook"} /><span>{s.name}</span></a></li>
      ))}
    </ul>
  </div>
</Section>

<style>
  .contacts__grid { display: grid; gap: var(--s-5); }
  .contacts h2 { max-width: 16ch; }
  .big-phone {
    display: inline-flex; align-items: center; gap: var(--s-2); margin-top: var(--s-4);
    min-height: 4.5rem; padding: var(--s-2) var(--s-4); border-radius: var(--radius-pill);
    background: var(--color-text); color: var(--color-accent); text-decoration: none;
    font: 400 clamp(1.75rem, 1rem + 3.2vw, 4rem)/1 var(--font-display); white-space: nowrap;
    transition: background-color var(--dur-short) var(--ease-out), transform var(--dur-micro) var(--ease-out);
  }
  .big-phone:hover { background: var(--color-graphite); }
  .big-phone:active { transform: translateY(1px); }
  .big-phone :global(.icon) { width: .7em; height: .7em; }
  .contacts__hint { margin-top: var(--s-3); font-size: var(--text-lead); max-width: 34ch; }
  .lines { list-style: none; border-top: var(--rule) solid var(--color-text); }
  .line {
    display: flex; align-items: center; gap: var(--s-2); min-height: 3.5rem; padding: var(--s-2) 0;
    border-bottom: var(--rule) solid var(--color-text); color: inherit; text-decoration: none; font-weight: 600; font-size: var(--text-lead);
  }
  .line :global(.icon) { flex: none; }
  .line span:first-of-type { min-width: 0; overflow-wrap: anywhere; }
  .line__more { margin-left: auto; font-size: var(--text-small); text-decoration: underline; text-decoration-thickness: var(--rule); text-underline-offset: .25em; }
  .line:hover span:first-of-type { text-decoration: underline; text-decoration-thickness: var(--rule); text-underline-offset: .25em; }
  @media (max-width: 29.99rem) {
    .big-phone { width: 100%; justify-content: center; padding: 0 var(--s-2); }
  }
  @media (min-width: 64rem) {
    .contacts__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: var(--s-5); align-items: end; }
  }
  @media (prefers-reduced-motion: reduce) { .big-phone:active { transform: none; } }
</style>
